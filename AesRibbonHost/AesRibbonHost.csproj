<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Aliniant.AesRibbonHost</RootNamespace>
    <AssemblyName>AesRibbonHost</AssemblyName>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ComVisible>true</ComVisible>
    <!-- Classic Outlook on this machine is 32-bit (x86); COM add-in must match. -->
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.3.32</Version>
    <AssemblyVersion>1.3.32.0</AssemblyVersion>
    <FileVersion>1.3.32.0</FileVersion>
    <InformationalVersion>1.3.32</InformationalVersion>
    <Title>Aliniant AES Ribbon Host</Title>
    <Description>Outlook COM add-in that hosts AES Ribbon XML (large Home icons, live ON/OFF).</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ribbon.xml" LogicalName="Aliniant.AesRibbonHost.Ribbon.xml" />
  </ItemGroup>
</Project>
